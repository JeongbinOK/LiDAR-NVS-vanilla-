ninja_required_version = 1.3
cxx = c++
nvcc = /data/hyuk/miniconda3/envs/utonia/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=chamfer_3D -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /data/hyuk/miniconda3/envs/utonia/lib/python3.10/site-packages/torch/include -isystem /data/hyuk/miniconda3/envs/utonia/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /data/hyuk/miniconda3/envs/utonia/lib/python3.10/site-packages/torch/include/TH -isystem /data/hyuk/miniconda3/envs/utonia/lib/python3.10/site-packages/torch/include/THC -isystem /data/hyuk/miniconda3/envs/utonia/include -isystem /data/hyuk/miniconda3/envs/utonia/include/python3.10 -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++17
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=chamfer_3D -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /data/hyuk/miniconda3/envs/utonia/lib/python3.10/site-packages/torch/include -isystem /data/hyuk/miniconda3/envs/utonia/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /data/hyuk/miniconda3/envs/utonia/lib/python3.10/site-packages/torch/include/TH -isystem /data/hyuk/miniconda3/envs/utonia/lib/python3.10/site-packages/torch/include/THC -isystem /data/hyuk/miniconda3/envs/utonia/include -isystem /data/hyuk/miniconda3/envs/utonia/include/python3.10 -D_GLIBCXX_USE_CXX11_ABI=0 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_89,code=sm_89 --compiler-options '-fPIC' --compiler-bindir /usr/bin/gcc-12 -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -L/data/hyuk/miniconda3/envs/utonia/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/data/hyuk/miniconda3/envs/utonia/lib -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx $in $ldflags -o $out

build chamfer_cuda.o: compile /data1/hyuk/LiDAR-NVS-vanilla-/src/models_new/utils/chamfer/chamfer3D/chamfer_cuda.cpp
build chamfer3D.cuda.o: cuda_compile /data1/hyuk/LiDAR-NVS-vanilla-/src/models_new/utils/chamfer/chamfer3D/chamfer3D.cu



build chamfer_3D.so: link chamfer_cuda.o chamfer3D.cuda.o

default chamfer_3D.so
